<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns="https://ontology.usu.ac.id/semantik/kampus#"
    xml:base="https://ontology.usu.ac.id/semantik/kampus">

    <owl:Ontology rdf:about="https://ontology.usu.ac.id/semantik/kampus">
        <rdfs:label xml:lang="id">Ontologi Kampus - Kelompok Vasha</rdfs:label>
    </owl:Ontology>

    <owl:ObjectProperty rdf:about="#takesCourse">
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="#Course"/>
        <rdfs:label xml:lang="id">mengambil mata kuliah</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#teachesCourse">
        <rdfs:domain rdf:resource="#Lecturer"/>
        <rdfs:range rdf:resource="#Course"/>
        <rdfs:label xml:lang="id">mengajar mata kuliah</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#registeredInDepartment">
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="#Department"/>
        <rdfs:label xml:lang="id">terdaftar di departemen</rdfs:label>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="#hasNIM">
        <rdfs:domain rdf:resource="#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="id">NIM</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasName">
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="id">Nama Lengkap</rdfs:label>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="#Course">
        <rdfs:label xml:lang="id">Mata Kuliah</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Department">
        <rdfs:label xml:lang="id">Departemen / Jurusan</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Person">
        <rdfs:label xml:lang="id">Orang</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Lecturer">
        <rdfs:subClassOf rdf:resource="#Person"/>
        <owl:disjointWith rdf:resource="#Student"/>
        <rdfs:label xml:lang="id">Dosen</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Student">
        <rdfs:subClassOf rdf:resource="#Person"/>

        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#takesCourse"/>
                <owl:someValuesFrom rdf:resource="#Course"/>
            </owl:Restriction>
        </rdfs:subClassOf>

        <rdfs:label xml:lang="id">Mahasiswa</rdfs:label>
    </owl:Class>

    <owl:NamedIndividual rdf:about="#nabil">
        <rdf:type rdf:resource="#Student"/>
        <takesCourse rdf:resource="#course_web_semantik"/>
        <registeredInDepartment rdf:resource="#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            NABIL AKBAR SOFYAN
        </hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            251402134
        </hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#yosua">
        <rdf:type rdf:resource="#Student"/>
        <takesCourse rdf:resource="#course_web_semantik"/>
        <registeredInDepartment rdf:resource="#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            YOSUA VALENTINO GULO
        </hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            251402055
        </hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#bayu">
        <rdf:type rdf:resource="#Student"/>
        <takesCourse rdf:resource="#course_web_semantik"/>
        <registeredInDepartment rdf:resource="#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            M. BAYU PRANOTO
        </hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            251402066
        </hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#vasha">
        <rdf:type rdf:resource="#Student"/>
        <takesCourse rdf:resource="#course_web_semantik"/>
        <registeredInDepartment rdf:resource="#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            M. VASHA NADAR
        </hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            251402019
        </hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#bariq">
        <rdf:type rdf:resource="#Student"/>
        <takesCourse rdf:resource="#course_web_semantik"/>
        <registeredInDepartment rdf:resource="#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            ALBARIQI DEANDA TARIGAN
        </hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            251402037
        </hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#pak_isa_dadi">
        <rdf:type rdf:resource="#Lecturer"/>
        <teachesCourse rdf:resource="#course_web_semantik"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
            Pak Isa Dadi
        </hasName>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#course_web_semantik">
        <rdf:type rdf:resource="#Course"/>
        <rdfs:label xml:lang="id">Web Semantik</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#prodi_ti">
        <rdf:type rdf:resource="#Department"/>
        <rdfs:label xml:lang="id">Teknologi Informasi</rdfs:label>
    </owl:NamedIndividual>

</rdf:RDF>

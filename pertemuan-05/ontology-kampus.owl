<?xml version="1.0" encoding="UTF-8"?>

<rdf:RDF xmlns="https://ontology.usu.ac.id/semantik/kampus#"
     xml:base="https://ontology.usu.ac.id/semantik/kampus"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
     
    <!-- Base Ontology -->
    <owl:Ontology rdf:about="https://ontology.usu.ac.id/semantik/kampus">
        <rdfs:label xml:lang="id">Ontologi Kampus - Kelompok Vasha</rdfs:label>
    </owl:Ontology>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="https://ontology.usu.ac.id/semantik/kampus#takesCourse">
        <rdfs:domain rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <rdfs:range rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Course"/>
        <rdfs:label xml:lang="id">mengambil mata kuliah</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="https://ontology.usu.ac.id/semantik/kampus#teachesCourse">
        <rdfs:domain rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Lecturer"/>
        <rdfs:range rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Course"/>
        <rdfs:label xml:lang="id">mengajar mata kuliah</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://ontology.usu.ac.id/semantik/kampus#registeredInDepartment">
        <rdfs:domain rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <rdfs:range rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Department"/>
        <rdfs:label xml:lang="id">terdaftar di departemen</rdfs:label>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="https://ontology.usu.ac.id/semantik/kampus#hasNIM">
        <rdfs:domain rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="id">NIM</rdfs:label>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="https://ontology.usu.ac.id/semantik/kampus#hasName">
        <rdfs:domain rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="id">Nama Lengkap</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Classes -->
    <owl:Class rdf:about="https://ontology.usu.ac.id/semantik/kampus#Course">
        <rdfs:label xml:lang="id">Mata Kuliah</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="https://ontology.usu.ac.id/semantik/kampus#Department">
        <rdfs:label xml:lang="id">Departemen / Jurusan</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="https://ontology.usu.ac.id/semantik/kampus#Person">
        <rdfs:label xml:lang="id">Orang</rdfs:label>
    </owl:Class>
    
    <!-- Class Rules & Hierarchy -->
    <owl:Class rdf:about="https://ontology.usu.ac.id/semantik/kampus#Lecturer">
        <rdfs:subClassOf rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Person"/>
        <owl:disjointWith rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <rdfs:label xml:lang="id">Dosen</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="https://ontology.usu.ac.id/semantik/kampus#Student">
        <rdfs:subClassOf rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontology.usu.ac.id/semantik/kampus#takesCourse"/>
                <owl:someValuesFrom rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Course"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="id">Mahasiswa</rdfs:label>
    </owl:Class>

    <!-- Instances / Individuals -->
    
    <!-- Data Mahasiswa (Kelompok) -->
    <owl:NamedIndividual rdf:about="https://ontology.usu.ac.id/semantik/kampus#nabil">
        <rdf:type rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <takesCourse rdf:resource="https://ontology.usu.ac.id/semantik/kampus#course_web_semantik"/>
        <registeredInDepartment rdf:resource="https://ontology.usu.ac.id/semantik/kampus#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NABIL AKBAR SOFYAN</hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">251402134</hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://ontology.usu.ac.id/semantik/kampus#yosua">
        <rdf:type rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <takesCourse rdf:resource="https://ontology.usu.ac.id/semantik/kampus#course_web_semantik"/>
        <registeredInDepartment rdf:resource="https://ontology.usu.ac.id/semantik/kampus#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">YOSUA VALENTINO GULO</hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">251402055</hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://ontology.usu.ac.id/semantik/kampus#bayu">
        <rdf:type rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <takesCourse rdf:resource="https://ontology.usu.ac.id/semantik/kampus#course_web_semantik"/>
        <registeredInDepartment rdf:resource="https://ontology.usu.ac.id/semantik/kampus#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M. BAYU PRANOTO</hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">251402066</hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://ontology.usu.ac.id/semantik/kampus#vasha">
        <rdf:type rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <takesCourse rdf:resource="https://ontology.usu.ac.id/semantik/kampus#course_web_semantik"/>
        <registeredInDepartment rdf:resource="https://ontology.usu.ac.id/semantik/kampus#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">M. VASHA NADAR</hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">251402019</hasNIM>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://ontology.usu.ac.id/semantik/kampus#bariq">
        <rdf:type rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Student"/>
        <takesCourse rdf:resource="https://ontology.usu.ac.id/semantik/kampus#course_web_semantik"/>
        <registeredInDepartment rdf:resource="https://ontology.usu.ac.id/semantik/kampus#prodi_ti"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALBARIQI DEANDA TARIGAN</hasName>
        <hasNIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">251402037</hasNIM>
    </owl:NamedIndividual>

    <!-- Data Dosen, Matkul, dan Prodi -->
    <owl:NamedIndividual rdf:about="https://ontology.usu.ac.id/semantik/kampus#pak_isa_dadi">
        <rdf:type rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Lecturer"/>
        <teachesCourse rdf:resource="https://ontology.usu.ac.id/semantik/kampus#course_web_semantik"/>
        <hasName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pak Isa Dadi</hasName>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://ontology.usu.ac.id/semantik/kampus#course_web_semantik">
        <rdf:type rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Course"/>
        <rdfs:label xml:lang="id">Web Semantik</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="https://ontology.usu.ac.id/semantik/kampus#prodi_ti">
        <rdf:type rdf:resource="https://ontology.usu.ac.id/semantik/kampus#Department"/>
        <rdfs:label xml:lang="id">Teknologi Informasi</rdfs:label>
    </owl:NamedIndividual>

</rdf:RDF>

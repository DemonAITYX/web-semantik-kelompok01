@prefix ex: <https://vshndrr-code.github.io/web-semantik/251402019/usu#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://vshndrr-code.github.io/web-semantik/251402019/graph/kampus> {

    ex:bayu a ex:Student ;
        foaf:name "Bayu"@id ;
        ex:mengambil ex:manajemen_sistem_basis_data .

    ex:dedy a ex:Lecturer ;
        foaf:name "Dedy Arisandi"@id ;
        ex:mengajar ex:manajemen_sistem_basis_data .

    ex:ida a ex:Lecturer ;
        foaf:name "Ida Adi"@id ;
        ex:mengajar ex:web_semantik .

    ex:umay a ex:Lecturer ;
        foaf:name "Umaya Nasution"@id ;
        ex:mengajar ex:pemrograman_web .

    ex:vasha a ex:Student ;
        foaf:name "Vasha"@id ;
        ex:mengambil ex:pemrograman_web,
            ex:web_semantik .

    ex:manajemen_sistem_basis_data a ex:Course ;
        foaf:name "Manajemen Sistem Basis Data"@id ;
        ex:hariKuliah "Jumat"@id ;
        ex:jumlahKredit 3 .

    ex:pemrograman_web a ex:Course ;
        foaf:name "Pemrograman Web"@id ;
        ex:hariKuliah "Rabu"@id ;
        ex:jumlahKredit 3 .

    ex:web_semantik a ex:Course ;
        foaf:name "Web Semantik"@id ;
        ex:hariKuliah "Senin"@id ;
        ex:jumlahKredit 3 .

    ex:pernyataan_ida_mengajar_web_semantik
        a rdf:Statement ;
        rdf:subject ex:ida ;
        rdf:predicate ex:mengajar ;
        rdf:object ex:web_semantik ;
        ex:keterangan "Ida Adi mengajar mata kuliah Web Semantik"@id .
}

<https://vshndrr-code.github.io/web-semantik/251402019/graph/fakultas> {

    ex:fasilkom_ti a ex:Faculty ;
        foaf:name "Fakultas Ilmu Komputer dan Teknologi Informasi"@id ;
        ex:berlokasiDi "Universitas Sumatera Utara"@id ;
        ex:memilikiDepartemen ex:departemen_ti .

    ex:departemen_ti a ex:Department ;
        foaf:name "Departemen Teknologi Informasi"@id ;
        ex:bagianDari ex:fasilkom_ti .
}

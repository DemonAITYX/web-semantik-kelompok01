@prefix ex: <http://contoh.id/kampus/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:budi a ex:Dosen,
        ex:DosenTetap,
        foaf:Person .

ex:rina a ex:Dosen,
        ex:DosenTetap,
        foaf:Person .

ex:rudi a ex:Tendik,
        foaf:Person .

ex:sari a ex:Dosen,
        foaf:Person .

ex:Tendik rdfs:subClassOf foaf:Person .

ex:DosenTetap rdfs:subClassOf ex:Dosen .

ex:Dosen rdfs:subClassOf foaf:Person .


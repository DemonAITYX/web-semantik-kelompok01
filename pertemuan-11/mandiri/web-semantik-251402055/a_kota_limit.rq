# Demo A: kota di Indonesia sebagai graf ex:
PREFIX ex: <http://contoh.id/>

CONSTRUCT {
  ?kota a ex:Kota ;
        rdfs:label ?namaKota ;
        ex:populasi ?populasi .
}
WHERE {
  ?kota wdt:P31/wdt:P279* wd:Q515 ;   # Q515 = kota
        wdt:P17 wd:Q252 ;             # Q252 = Indonesia
        wdt:P1082 ?populasi ;         # P1082 = populasi
        rdfs:label ?namaKota .
  FILTER ( LANG(?namaKota) = "id" )
}
LIMIT 10
